// Variables used by Scriptable.
// These must be at the very top of the file. Do not edit.
// icon-color: orange; icon-glyph: dumbbell;

/* =========================================================================
 * PROVERLOAD — progressive-overload tracker for Scriptable
 *
 *   Run it in the Scriptable app  -> full logging UI (WebView)
 *   Put it on the home screen     -> weekly volume widget
 *
 * All data lives in ONE json file so the widget and the app read the same
 * source of truth:
 *   iCloud Drive / Scriptable / proverload/data.json   (local fallback)
 *
 * Generated from src/ by build.js — edit the sources, not this file.
 * ======================================================================= */

const DATA_DIR = 'proverload';
const DATA_FILE = 'data.json';
const ACCENT = '#FF9F45';
const GOOD = '#4ADE80';
const BAD = '#F87171';
const DIM = '#8A8F98';

//__CORE__

/* ======================================================================== */
/* Storage                                                                  */
/* ======================================================================== */

function makeStore() {
  let fm, dir, path;
  try {
    fm = FileManager.iCloud();
    fm.documentsDirectory();
    dir = fm.joinPath(fm.documentsDirectory(), DATA_DIR);
    if (!fm.fileExists(dir)) fm.createDirectory(dir, true);
    path = fm.joinPath(dir, DATA_FILE);
  } catch (e) {
    // iCloud Drive unavailable/not enabled for Scriptable — fall back to
    // local, on-device storage rather than letting the script die silently.
    console.error('Proverload: iCloud storage unavailable, using local — ' + e);
    fm = FileManager.local();
    dir = fm.joinPath(fm.documentsDirectory(), DATA_DIR);
    if (!fm.fileExists(dir)) fm.createDirectory(dir, true);
    path = fm.joinPath(dir, DATA_FILE);
  }

  return {
    fm: fm,
    dir: dir,
    path: path,
    read: function () {
      if (!fm.fileExists(path)) return migrate(emptyState());
      try {
        if (fm.isFileStoredIniCloud && fm.isFileStoredIniCloud(path) && !fm.isFileDownloaded(path)) {
          fm.downloadFileFromiCloud(path);
        }
        return migrate(JSON.parse(fm.readString(path)));
      } catch (e) {
        console.error('Proverload: could not read data file — ' + e);
        return migrate(emptyState());
      }
    },
    write: function (state) {
      const backup = fm.joinPath(dir, 'data.backup.json');
      if (fm.fileExists(path)) {
        try { fm.writeString(backup, fm.readString(path)); } catch (e) {}
      }
      fm.writeString(path, JSON.stringify(state));
    },
  };
}

/* ======================================================================== */
/* Widget                                                                   */
/* ======================================================================== */

function col(hex) { return new Color(hex); }

/** Sparkline of weekly volume, most recent bar highlighted. */
function volumeChart(weeks, width, height) {
  const dc = new DrawContext();
  dc.size = new Size(width, height);
  dc.opaque = false;
  dc.respectScreenScale = true;
  const max = Math.max.apply(null, weeks.map(function (w) { return w.volume; }).concat([1]));
  const gap = 3;
  const bw = (width - gap * (weeks.length - 1)) / weeks.length;
  weeks.forEach(function (w, i) {
    const h = Math.max(2, (w.volume / max) * height);
    const x = i * (bw + gap);
    const last = i === weeks.length - 1;
    dc.setFillColor(new Color(last ? ACCENT : '#FFFFFF', last ? 1 : 0.22));
    dc.fillRect(new Rect(x, height - h, bw, h));
  });
  return dc.getImage();
}

function addBar(stack, pct, width, height, color) {
  const track = stack.addStack();
  track.size = new Size(width, height);
  track.backgroundColor = new Color('#FFFFFF', 0.13);
  track.cornerRadius = height / 2;
  track.layoutHorizontally();
  const fill = track.addStack();
  fill.size = new Size(Math.max(height, Math.min(1, pct) * width), height);
  fill.backgroundColor = new Color(color, pct >= 1 ? 1 : 0.85);
  fill.cornerRadius = height / 2;
  track.addSpacer();
}

function label(stack, text, size, color, opts) {
  const t = stack.addText(text);
  t.font = (opts && opts.bold) ? Font.boldRoundedSystemFont(size)
         : (opts && opts.medium) ? Font.mediumSystemFont(size)
         : Font.systemFont(size);
  t.textColor = col(color);
  t.lineLimit = (opts && opts.lines) || 1;
  if (opts && opts.minScale) t.minimumScaleFactor = opts.minScale;
  return t;
}

function buildWidget(state, family) {
  const w = new ListWidget();
  const g = new LinearGradient();
  g.colors = [new Color('#14161A'), new Color('#0B0C0E')];
  g.locations = [0, 1];
  w.backgroundGradient = g;
  w.setPadding(14, 14, 14, 14);
  w.url = 'scriptable:///run/' + encodeURIComponent(Script.name());

  const s = weekSummary(state);
  const unit = state.settings.unit || 'kg';
  const small = family === 'small';

  if (!state.sessions.length) {
    label(w, 'PROVERLOAD', 10, ACCENT, { bold: true });
    w.addSpacer(6);
    label(w, 'No sessions yet', 15, '#FFFFFF', { bold: true });
    w.addSpacer(3);
    const t = w.addText('Tap to open the app and log your first workout.');
    t.font = Font.systemFont(11);
    t.textColor = col(DIM);
    t.lineLimit = 3;
    w.addSpacer();
    return w;
  }

  /* --- header ------------------------------------------------------- */
  const head = w.addStack();
  head.centerAlignContent();
  label(head, 'WEEK OF ' + shortDate(s.week).toUpperCase(), 9, DIM, { medium: true });
  head.addSpacer();
  if (!small) label(head, s.sessions + ' session' + (s.sessions === 1 ? '' : 's'), 9, DIM, { medium: true });

  w.addSpacer(small ? 6 : 8);

  /* --- headline volume ---------------------------------------------- */
  const big = w.addStack();
  big.bottomAlignContent();
  label(big, fmtVolume(s.volume, unit), small ? 30 : 34, '#FFFFFF', { bold: true, minScale: 0.6 });
  big.addSpacer(4);
  label(big, unit + ' moved', 11, DIM, { medium: true });
  big.addSpacer();

  const sub = w.addStack();
  sub.centerAlignContent();
  if (s.delta === null) {
    label(sub, 'first week tracked', 11, DIM);
  } else {
    const up = s.delta >= 0;
    label(sub, (up ? '▲ ' : '▼ ') + fmtPct(s.delta), 12, up ? GOOD : BAD, { bold: true });
    sub.addSpacer(5);
    label(sub, 'vs last week', 11, DIM);
  }
  sub.addSpacer();
  if (!small) label(sub, fmtSets(s.sets) + ' hard sets', 11, DIM, { medium: true });

  w.addSpacer(small ? 8 : 10);

  if (small) {
    w.addImage(volumeChart(s.history.slice(-8), 130, 30)).imageSize = new Size(130, 30);
    w.addSpacer(4);
    const lag = s.lagging[0];
    if (lag) label(w, 'Next: ' + lag.name + ' ' + fmtSets(lag.sets) + '/' + lag.target, 10, ACCENT, { medium: true });
    w.addSpacer();
    return w;
  }

  /* --- medium / large: muscle progress ------------------------------ */
  const body = w.addStack();
  body.layoutHorizontally();
  body.spacing = 14;

  const left = body.addStack();
  left.layoutVertically();
  const rows = family === 'large' ? MUSCLES.length : 4;
  const ranked = s.muscles.slice().sort(function (a, b) {
    return (b.sets - a.sets) || (b.target - a.target);
  }).slice(0, rows);

  ranked.forEach(function (m, i) {
    if (i) left.addSpacer(family === 'large' ? 7 : 5);
    const row = left.addStack();
    row.centerAlignContent();
    const name = row.addText(m.name);
    name.font = Font.mediumSystemFont(10);
    name.textColor = col('#D8DBE0');
    name.lineLimit = 1;
    row.addSpacer();
    const n = row.addText(fmtSets(m.sets) + '/' + m.target);
    n.font = Font.boldSystemFont(10);
    n.textColor = col(m.sets >= m.target ? GOOD : DIM);
    left.addSpacer(3);
    addBar(left, m.pct, family === 'large' ? 300 : 148, 5, m.color);
  });

  if (family !== 'large') {
    const right = body.addStack();
    right.layoutVertically();
    label(right, 'LAST 8 WEEKS', 8, DIM, { medium: true });
    right.addSpacer(6);
    right.addImage(volumeChart(s.history.slice(-8), 120, 46)).imageSize = new Size(120, 46);
    right.addSpacer(6);
    const lag = s.lagging[0];
    if (lag) {
      label(right, 'FOCUS NEXT', 8, DIM, { medium: true });
      right.addSpacer(3);
      label(right, lag.name, 12, ACCENT, { bold: true });
      label(right, 'needs ' + fmtSets(lag.target - lag.sets) + ' more sets', 10, DIM);
    }
    right.addSpacer();
  }

  if (family === 'large') {
    w.addSpacer(10);
    const strip = w.addStack();
    strip.layoutHorizontally();
    strip.spacing = 12;
    const chartCol = strip.addStack();
    chartCol.layoutVertically();
    label(chartCol, 'LAST 9 WEEKS', 8, DIM, { medium: true });
    chartCol.addSpacer(5);
    chartCol.addImage(volumeChart(s.history, 150, 40)).imageSize = new Size(150, 40);

    const prCol = strip.addStack();
    prCol.layoutVertically();
    label(prCol, 'RECENT LIFTS', 8, DIM, { medium: true });
    prCol.addSpacer(5);
    personalRecords(state).slice(0, 3).forEach(function (p, i) {
      if (i) prCol.addSpacer(3);
      const r = prCol.addStack();
      r.centerAlignContent();
      const nm = r.addText(p.name);
      nm.font = Font.systemFont(10);
      nm.textColor = col('#D8DBE0');
      nm.lineLimit = 1;
      r.addSpacer(6);
      const v = r.addText(fmtWeight(p.e1rm, unit));
      v.font = Font.boldSystemFont(10);
      v.textColor = col(p.isFreshPR ? GOOD : DIM);
    });
    strip.addSpacer();
  }

  w.addSpacer();
  w.refreshAfterDate = new Date(Date.now() + 30 * 60 * 1000);
  return w;
}

/* ======================================================================== */
/* App (WebView UI)                                                         */
/* ======================================================================== */

const HTML = '__HTML__';

function sleep(ms) {
  return new Promise(function (r) { Timer.schedule(ms, false, r); });
}

async function runApp(store) {
  const wv = new WebView();
  await wv.loadHTML(HTML, null, new Size(0, 0), true);
  const dismissed = wv.present(true).then(function () { return '__CLOSED__'; });

  let state = store.read();
  let alive = true;

  while (alive) {
    let raw;
    try {
      raw = await Promise.race([wv.evaluateJavaScript('__nextRequest(completion)', true), dismissed]);
    } catch (e) {
      await sleep(120);
      continue;
    }
    if (raw === '__CLOSED__' || raw == null) break;

    let msg;
    try { msg = JSON.parse(raw); } catch (e) { continue; }

    let reply;
    try {
      reply = { ok: true, data: await handleRequest(msg.action, msg.payload, store, state, function (s) { state = s; }) };
    } catch (e) {
      console.error('Proverload action "' + msg.action + '" failed: ' + e);
      reply = { ok: false, error: String(e) };
    }
    if (msg.action === 'close') { alive = false; }
    try {
      await wv.evaluateJavaScript('__resolve(' + msg.id + ',' + JSON.stringify(JSON.stringify(reply)) + ')', false);
    } catch (e) { break; }
  }
}

async function handleRequest(action, payload, store, state, setState) {
  switch (action) {
    case 'load':
      return { state: state, storage: store.path.indexOf('Mobile Documents') >= 0 ? 'iCloud Drive' : 'On my iPhone' };

    case 'save': {
      const next = migrate(payload.state);
      store.write(next);
      setState(next);
      return { savedAt: new Date().toISOString() };
    }

    case 'haptic':
      if (payload && payload.kind === 'heavy') Haptic.heavy(); else Haptic.light();
      return {};

    case 'previewWidget': {
      const w = buildWidget(state, payload && payload.family === 'small' ? 'small' : 'medium');
      if (payload && payload.family === 'small') await w.presentSmall();
      else if (payload && payload.family === 'large') await w.presentLarge();
      else await w.presentMedium();
      return {};
    }

    case 'export': {
      const tmp = FileManager.local();
      const out = tmp.joinPath(tmp.temporaryDirectory(), 'proverload-' + todayKey() + '.json');
      tmp.writeString(out, JSON.stringify(state, null, 2));
      await DocumentPicker.exportFile(out);
      return {};
    }

    case 'import': {
      const paths = await DocumentPicker.open(['public.json', 'public.text']);
      if (!paths || !paths.length) return { cancelled: true };
      const fm = FileManager.local();
      const next = migrate(JSON.parse(fm.readString(paths[0])));
      store.write(next);
      setState(next);
      return { state: next };
    }

    case 'close':
      return {};

    default:
      throw new Error('unknown action: ' + action);
  }
}

/* ======================================================================== */
/* Entry point                                                              */
/* ======================================================================== */

async function fail(where, e) {
  console.error('Proverload: ' + where + ' failed — ' + e);
  try {
    const a = new Alert();
    a.title = 'Proverload failed to open';
    a.message = where + ':\n' + String((e && e.stack) || (e && e.message) || e);
    a.addAction('OK');
    await a.presentAlert();
  } catch (e2) {
    // even Alert failed — nothing more we can do but log it
    console.error('Proverload: could not even show the failure alert — ' + e2);
  }
}

async function main() {
  if (config.runsInWidget || config.runsInAccessoryWidget) {
    // Widgets can't show an Alert, so let a failure surface as Scriptable's
    // normal error log rather than swallowing it.
    const store = makeStore();
    const state = store.read();
    const family = config.runsInAccessoryWidget ? 'small' : (config.widgetFamily || args.widgetParameter || 'medium');
    Script.setWidget(buildWidget(state, family));
  } else {
    try {
      const store = makeStore();
      await runApp(store);
    } catch (e) {
      // Covers makeStore() failing (e.g. iCloud Drive unavailable) as well
      // as the WebView itself failing to load or present — either way,
      // something visible shows up instead of a blank screen.
      await fail('startup', e);
    }
  }
  Script.complete();
}

try {
  await main();
} catch (e) {
  await fail('main', e);
  Script.complete();
}
